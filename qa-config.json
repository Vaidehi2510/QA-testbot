{
  "enabled": false,
  "targetAccess": "report-status",
  "executionRef": "main",
  "stateBranch": "qa-state",
  "environment": "synthetic-node22",
  "needsQaLabel": "needs-qa",
  "completeLabel": "qa-complete",
  "scope": { "prNumbers": [], "label": "needs-qa", "milestone": null },
  "decisionReviewers": [],
  "featureOwners": {},
  "qaGroupId": "",
  "specificationPaths": [],
  "maxIntegrationAttempts": 5,
  "dispatchTimeoutMinutes": 45,
  "drive": { "folderId": "", "sharedDriveId": "" },
  "ai": {
    "enabled": false,
    "backend": "openrouter",
    "local": { "baseUrl": "http://127.0.0.1:11434/v1", "models": [] },
    "model": "",
    "roleModels": {},
    "roles": ["planner", "code-review", "security", "ui-ux", "triage"],
    "requireReview": true,
    "maxToolRounds": 3,
    "maxCallsPerRun": 20,
    "maxInputChars": 100000,
    "maxOutputTokens": 3000,
    "maxCostUsd": 2,
    "includePaths": ["**"],
    "excludePaths": [],
    "allowImages": false,
    "provider": { "data_collection": "deny", "allow_fallbacks": false, "require_parameters": true }
  },
  "runners": [
    {
      "id": "node-tests",
      "type": "node-test",
      "baseline": true,
      "files": ["test/*.test.js"],
      "timeoutMs": 120000,
      "expected": "All assertions in the configured baseline suite pass; at least one test executes.",
      "requirement": "Trusted target test suite configured by the QA maintainer"
    }
  ]
}
