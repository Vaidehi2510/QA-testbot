{
  "name": "qa-signoff-bot",
  "version": "1.5.0",
  "description": "Automated product QA for pull requests, builds and releases, with isolated tests, browser/native evidence and local/OpenRouter model selection.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "demo": "node src/demo.js",
    "demo:ai": "node src/ai/demo.js",
    "dashboard": "node src/dashboard.js",
    "review": "node src/ai/review.js",
    "sync": "node src/run.js",
    "test": "node --test test/*.test.js",
    "execute": "node src/execute.js",
    "qa:web": "node src/web/cli.js",
    "demo:web": "node src/web/demo.js",
    "qa:autonomous": "node src/autonomy/cli.js",
    "qa:accept-baseline": "node src/web/visual.js",
    "qa:native": "node src/native/cli.js",
    "demo:web:advanced": "node src/web/demo-advanced.js",
    "qa:release": "node src/release/cli.js",
    "qa:gate": "node src/release/cli.js gate",
    "qa:hash-artifact": "node src/release/hash-artifact.js",
    "qa:record": "node src/web/record.js",
    "qa:fleet": "node src/native/fleet.js"
  },
  "dependencies": {
    "@axe-core/playwright": "4.13.0",
    "@octokit/auth-app": "^7.1.3",
    "@octokit/rest": "^21.0.2",
    "fast-xml-parser": "5.11.2",
    "playwright-core": "1.63.0",
    "pngjs": "7.0.0"
  }
}
