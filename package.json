{
  "name": "qa-signoff-bot",
  "version": "1.3.0",
  "description": "AI QA team with local/OpenRouter models, isolated tests, automated web preview audits, and PR reporting without product code writes.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "demo": "node src/demo.js",
    "demo:ai": "node src/ai/demo.js",
    "dashboard": "node src/dashboard.js",
    "review": "node src/ai/review.js",
    "sync": "node src/run.js",
